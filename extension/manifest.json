{
  "manifest_version": 3,
  "name": "Penguin Focus Buddy",
  "version": "1.5.0",
  "key": "",
  "description": "Lets the Penguin desktop app close distracting tabs during focus time.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "alarms", "sessions"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" }
}
